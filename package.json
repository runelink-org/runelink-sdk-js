{
  "name": "@runelink/sdk",
  "version": "0.1.0",
  "description": "Runelink SDK for JavaScript/TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/commonjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "prepack": "pnpm build",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "node --test tests/*.test.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "keywords": [
    "runelink",
    "chat",
    "federation",
    "websocket",
    "sdk"
  ],
  "author": "Connor Kress <connor@ckress.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runelink-org/runelink-sdk-js.git"
  },
  "homepage": "https://github.com/runelink-org/runelink-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/runelink-org/runelink-sdk-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
