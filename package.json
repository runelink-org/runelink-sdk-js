{
  "name": "@runelink/sdk",
  "version": "0.3.0",
  "description": "Runelink SDK for JavaScript/TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/commonjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "prepack": "pnpm build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "tsc -p tests/tsconfig.json && vitest run",
    "check:package": "node scripts/check-package.mjs",
    "lint": "oxlint --report-unused-disable-directives-severity error .",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json && effect-tsgo diagnostics --project tests/tsconfig.json"
  },
  "keywords": [
    "runelink",
    "chat",
    "federation",
    "websocket",
    "sdk"
  ],
  "author": "Connor Kress <connor@ckress.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runelink-org/runelink-sdk-js.git"
  },
  "homepage": "https://github.com/runelink-org/runelink-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/runelink-org/runelink-sdk-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "@effect/vitest": "4.1.5",
    "@oxlint/plugins": "1.95.0",
    "@types/node": "^26.6.11",
    "effect": "4.1.5",
    "esbuild": "^0.28.2",
    "oxlint": "1.95.0",
    "oxlint-plugin-eslint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "peerDependencies": {
    "effect": "^4.1.5"
  }
}
